# This file documents non-secret path names only. Never copy secrets into a
# repository-local dotenv: /mnt/e has no effective POSIX chmod isolation.
# Inject secrets from an approved external store/process environment only.
# Runtime roots must be WSL-native absolute paths outside the repository.
RTKFREE_DATA_ROOT=
RTKFREE_RUN_ROOT=
# Intentionally omitted from ordinary training/development environments:
# RTKFREE_SEALED_REFERENCE_ROOT=
